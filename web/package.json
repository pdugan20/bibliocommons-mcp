{
  "name": "bibliocommons-mcp-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP Apps UI bundles for the bibliocommons-mcp server.",
  "scripts": {
    "dev": "vite --config workbench/vite.config.ts",
    "build:bundles": "node scripts/inline_bundles.mjs",
    "check:covers": "node scripts/check-fixture-covers.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
