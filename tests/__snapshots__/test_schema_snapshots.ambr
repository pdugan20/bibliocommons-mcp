    'cancel_hold': dict({
      'annotations': dict({
        'destructiveHint': True,
        'idempotentHint': False,
        'openWorldHint': True,
        'readOnlyHint': False,
        'title': None,
      }),
      'description': '''
        Cancel a hold by id.
        
        **Irreversible** — cancelling loses your queue position. Confirm
        with the user first.
        
        For multiple holds, prefer `cancel_holds` — it's one round-trip
        instead of N.
        
        Args:
            hold_id: From `list_holds().holds[i].hold_id`.
            bib_id: From the same row's `metadata_id`. Both are required by
                the gateway.
            dry_run: If true, look up the hold and describe what would be
                cancelled without actually cancelling it. Useful as an
                agent self-check before calling with `dry_run=False`.
  
      ''',
      'inputSchema': dict({
        'properties': dict({
          'bib_id': dict({
            'title': 'Bib Id',
            'type': 'string',
          }),
          'dry_run': dict({
            'default': False,
            'title': 'Dry Run',
            'type': 'boolean',
          }),
          'hold_id': dict({
            'title': 'Hold Id',
            'type': 'string',
          }),
        }),
        'required': list([
          'hold_id',
          'bib_id',
        ]),
        'title': 'cancel_holdArguments',
        'type': 'object',
      }),
      'outputSchema': dict({
        'properties': dict({
          'dry_run': dict({
            'default': False,
            'description': 'If true, nothing was actually cancelled — the tool was called with dry_run=True and only describes what would happen.',
            'title': 'Dry Run',
            'type': 'boolean',
          }),
          'failures': dict({
            'additionalProperties': dict({
              'type': 'string',
            }),
            'description': 'Hold-id-keyed map of failure reasons. Empty on full success.',
            'title': 'Failures',
            'type': 'object',
          }),
          'success': dict({
            'title': 'Success',
            'type': 'boolean',
          }),
          'would_cancel': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'On a dry run, a human-readable summary of the hold that would be cancelled (title + queue position). None when dry_run=False.',
            'title': 'Would Cancel',
          }),
        }),
        'required': list([
          'success',
        ]),
        'title': 'CancelHoldResult',
        'type': 'object',
      }),
      'title': 'Cancel a hold',
    }),
    'cancel_holds': dict({
      'annotations': dict({
        'destructiveHint': True,
        'idempotentHint': False,
        'openWorldHint': True,
        'readOnlyHint': False,
        'title': None,
      }),
      'description': '''
        Cancel one or more holds in a single gateway call.
        
        **Irreversible** for each cancelled hold (lost queue position).
        Confirm with the user before calling with `dry_run=False`.
        
        Prefer this over multiple `cancel_hold` calls when the user has a
        list — it's one HTTP round-trip and one server-side transaction.
        
        Args:
            holds: List of `{hold_id, bib_id}` pairs. Construct each entry
                from a row in `list_holds().holds` — `hold_id` and
                `metadata_id` map directly.
            dry_run: If true, look up each hold and report what would be
                cancelled without doing it. Use as a self-check before
                committing.
  
      ''',
      'inputSchema': dict({
        '$defs': dict({
          'HoldRef': dict({
            'description': 'Reference to a hold + its bib. Both are required to cancel.',
            'properties': dict({
              'bib_id': dict({
                'description': 'From `Hold.metadata_id`.',
                'title': 'Bib Id',
                'type': 'string',
              }),
              'hold_id': dict({
                'description': 'From `Hold.hold_id`.',
                'title': 'Hold Id',
                'type': 'string',
              }),
            }),
            'required': list([
              'hold_id',
              'bib_id',
            ]),
            'title': 'HoldRef',
            'type': 'object',
          }),
        }),
        'properties': dict({
          'dry_run': dict({
            'default': False,
            'title': 'Dry Run',
            'type': 'boolean',
          }),
          'holds': dict({
            'items': dict({
              '$ref': '#/$defs/HoldRef',
            }),
            'title': 'Holds',
            'type': 'array',
          }),
        }),
        'required': list([
          'holds',
        ]),
        'title': 'cancel_holdsArguments',
        'type': 'object',
      }),
      'outputSchema': dict({
        'description': 'Result of `cancel_holds(...)`. Per-hold success/failure breakdown.',
        'properties': dict({
          'cancelled': dict({
            'description': 'Hold IDs successfully cancelled.',
            'items': dict({
              'type': 'string',
            }),
            'title': 'Cancelled',
            'type': 'array',
          }),
          'dry_run': dict({
            'default': False,
            'title': 'Dry Run',
            'type': 'boolean',
          }),
          'failures': dict({
            'additionalProperties': dict({
              'type': 'string',
            }),
            'description': 'Hold-id-keyed map of failure reasons.',
            'title': 'Failures',
            'type': 'object',
          }),
          'would_cancel': dict({
            'description': 'On a dry run, one human-readable summary per hold that would be cancelled (title + queue position). Empty when dry_run=False.',
            'items': dict({
              'type': 'string',
            }),
            'title': 'Would Cancel',
            'type': 'array',
          }),
        }),
        'title': 'BulkCancelHoldsResult',
        'type': 'object',
      }),
      'title': 'Cancel multiple holds in one call',
    }),
