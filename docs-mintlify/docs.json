{
  "$schema": "https://mintlify.com/schema.json",
  "theme": "luma",
  "name": "bibliocommons-mcp",
  "description": "An MCP server for BiblioCommons public libraries: search the catalog, place holds, and manage checkouts from Claude.",
  "logo": { "light": "/logo/light.svg", "dark": "/logo/dark.svg" },
  "favicon": "/favicon.svg",
  "appearance": { "default": "system" },
  "colors": { "primary": "#0062AA", "light": "#4D9FE8", "dark": "#0062AA" },
  "contextual": {
    "options": ["copy", "view", "claude", "chatgpt", "cursor", "vscode", "mcp"]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/pdugan20/bibliocommons-mcp"
    }
  },
  "footer": {
    "socials": { "github": "https://github.com/pdugan20/bibliocommons-mcp" }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["introduction", "quickstart", "requirements", "install"]
          },
          {
            "group": "Everyday use",
            "pages": [
              "guides/search",
              "guides/holds",
              "guides/digital",
              "guides/loans",
              "guides/branches"
            ]
          },
          {
            "group": "Claude (MCP)",
            "pages": [
              "guides/recipes",
              "concepts/local-vs-remote",
              "guides/self-host-remote"
            ]
          },
          {
            "group": "Concepts",
            "pages": ["concepts/architecture", "concepts/security"]
          },
          { "group": "Help", "pages": ["troubleshooting", "changelog"] }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "reference/cli",
              "reference/mcp-tools",
              "reference/configuration"
            ]
          }
        ]
      }
    ]
  }
}
